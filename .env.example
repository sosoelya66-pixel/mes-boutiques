# Copie ce fichier en .env.local (sur ton ordinateur) ou colle ces variables dans Vercel.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# La seule adresse autorisée à se connecter
ALLOWED_EMAIL=ton.adresse@gmail.com

# --- Connecteur Cowork ---
# Supabase → Project Settings → API Keys → Secret key (ne jamais la partager)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Jeton secret du connecteur (au moins 24 caractères) : l'adresse sera https://<app>.vercel.app/api/mcp/<MCP_TOKEN>
MCP_TOKEN=une-longue-suite-de-caracteres-aleatoires

# --- Synchro des e-mails Vinted (étape 3) ---
# Adresse iCloud principale et mot de passe pour app (account.apple.com → Mots de passe pour applications)
ICLOUD_EMAIL=ton.adresse@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Clé API Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optionnel : modèle utilisé pour lire les e-mails (par défaut claude-opus-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Notifications (Web Push) ---
VAPID_PUBLIC_KEY=xxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxx

# --- Fiches avec Claude + photos portées ---
# Clé API OpenAI (platform.openai.com → API keys) pour générer les photos portées
OPENAI_API_KEY=sk-xxxxxxxx
# Optionnel : modèle et qualité des images
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium
